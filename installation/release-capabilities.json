      "short_url_verified": true,
      "archive_url": "https://github.com/synthesisengineering/synthesis-skills/releases/download/v4.101.1/synthesis-4.101.1.tar.gz",
      "archive_sha256": "f5a26816afa836547191ae57a827df7dbe70ab361f9d1c51deabc653f238606d"
    },
    "channels": {
      "brew": {
        "status": "verified",
        "package": "synthesisengineering/tap/synthesis",
        "install": [
          "brew install synthesisengineering/tap/synthesis",
          "synthesis setup --profile {profile}"
        ],
        "platforms": [
          "macos-arm64"
        ],
        "evidence_url": "https://github.com/synthesisengineering/homebrew-tap/blob/19a1cb145079b5e7187f00bdd211b31e540af661/Formula/synthesis.rb",
        "release": "4.101.1"
      },
      "npm": {
        "status": "verified",
        "package": "@synthesiswork/synthesis",
        "install": [
          "npm install -g @synthesiswork/synthesis",
          "synthesis setup --profile {profile}"
        ],
        "platforms": [
          "macos-arm64"
        ],
        "evidence_url": "https://registry.npmjs.org/@synthesiswork/synthesis/4.101.1",
        "release": "4.101.1"
      },
      "bun": {
        "status": "verified",
        "package": "@synthesiswork/synthesis",
        "install": [
          "bun add -g @synthesiswork/synthesis",
          "synthesis setup --profile {profile}"
        ],
        "platforms": [
          "macos-arm64"
        ],
        "evidence_url": "https://registry.npmjs.org/@synthesiswork/synthesis/4.101.1",
        "release": "4.101.1"
      }
    },
    "deferred_channels": {
      "paru": {
        "reason": "AUR account registration is temporarily closed; excluded by user direction from this release.",
        "status": "deferred"
      }
